# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin Configuration
# Option A: Path to service account json file (relative to server directory or absolute)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# Option B (Production): Base64 encoded JSON string of service account key
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API (Email Outreach)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# n8n Webhook Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crm-events
N8N_INBOUND_SECRET=your_shared_webhook_secret_here

